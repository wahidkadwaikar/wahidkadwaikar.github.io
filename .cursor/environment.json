{
  "name": "Wahid Kadwaikar Blog",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "git submodule update --init --recursive",
  "terminals": [
    {
      "name": "hugo",
      "command": "hugo server -D --bind 0.0.0.0 --port 1313",
      "description": "Hugo development server with live reload on port 1313"
    }
  ],
  "ports": [
    {
      "name": "hugo",
      "port": 1313
    }
  ]
}
